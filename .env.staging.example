# Copy to a private file outside git. Never use these example values as secrets.
STAGING_DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
STAGING_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Behind an HTTPS reverse proxy or private tunnel; do not expose the container directly.
STAGING_WEB_ORIGIN=https://staging.example.com
STAGING_API_BASE_URL=https://staging.example.com/api
