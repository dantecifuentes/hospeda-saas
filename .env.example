DATABASE_URL=postgresql://localhost/hospeda
JWT_SECRET=replace-with-a-long-random-secret
API_PORT=53128
# Production photo storage: configure an S3/R2 adapter before deployment.
# Payment provider credentials will be added server-side only; never expose them to Vite/client code.

# Mercado Pago Checkout Pro: disabled unless ALL fields below are set. Single merchant account only.
MP_PAYMENTS_ENABLED=false
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
PUBLIC_API_URL=
PUBLIC_WEB_URL=

# Public frontend API endpoint (e.g. https://api.example.com/api)
VITE_API_BASE_URL=

# Persistent mounted disk for uploads; must survive app restarts/redeploys
STORAGE_DIR=uploads
